{
  "name": "gomac-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "GOMAC telemetry dashboard: polls Gomtuu's live MQTT telemetry (Victron BLE, Pandora, GPS, ping-monitor) plus Open-Meteo, and serves it to a browser as a plain JSON snapshot.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
