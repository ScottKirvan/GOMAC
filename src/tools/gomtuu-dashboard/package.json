{
  "name": "gomac-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "GOMAC telemetry dashboard: serves Gomtuu's live MQTT telemetry (Victron BLE, Pandora) to a browser over WebSocket.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
